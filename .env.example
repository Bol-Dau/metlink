# ==============================================================================
# METLINK Environment Configuration Template
# Copy this file to .env and fill in your local or production credentials.
# Never commit real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL & Psycopg 3)
# ------------------------------------------------------------------------------
# Optional full PostgreSQL connection URI (e.g. for managed cloud databases like Neon)
# When set and non-empty, DATABASE_URL takes precedence over the separate DB_* variables below.
# DATABASE_URL=postgresql://user:password@host:5432/metlink_db?sslmode=require

# Hostname or IP of the PostgreSQL database server (default: localhost)
DB_HOST=localhost

# Port on which PostgreSQL is listening (default: 5432)
DB_PORT=5432

# Name of the METLINK PostgreSQL database (default: metlink_db)
DB_NAME=metlink_db

# PostgreSQL user used by the backend and init_db.sh (default: postgres or metlink_user)
DB_USER=postgres

# Password for the PostgreSQL user
DB_PASSWORD=your_postgres_password

# Database connection timeout in seconds (default: 5)
DB_CONNECT_TIMEOUT=5

# Optional SSL mode for separate DB_* connections (e.g. disable, prefer, require, verify-ca, verify-full; ignored if DATABASE_URL is set)
# DB_SSLMODE=prefer

# ------------------------------------------------------------------------------
# Auth and Security
# ------------------------------------------------------------------------------
# Secret key used for signing HS256 JWT tokens
# Generate a strong 256-bit random secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-secret

# Optional cookie security flag (allowed: true, false; note: current API uses JWT Bearer headers, not cookies)
# COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Africa's Talking SMS & USSD Integration
# ------------------------------------------------------------------------------
# Africa's Talking username: use "sandbox" for local testing, or your live app username
AT_USERNAME=sandbox

# Africa's Talking API key generated from the developer dashboard
AT_API_KEY=your_africastalking_api_key

# Optional approved Alphanumeric Sender ID or shortcode (leave empty in sandbox)
AT_SENDER_ID=

# SMS dispatch mode: "live" sends real SMS via Africa's Talking; "log_only" records to DB without sending
SMS_MODE=log_only

# Auto-mark sandbox SMS as DELIVERED after dispatch (allowed: true, false; default: false)
SMS_SANDBOX_AUTO_DELIVERED=false

# Shared secret token for USSD callback and SMS delivery webhook URL validation (?token=YOUR_TOKEN)
AT_WEBHOOK_TOKEN=your_webhook_security_token

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
# Port on which the Flask backend listens (default: 5050)
PORT=5050

# Allowed CORS origins for /api/* routes (comma-separated list, or * for all origins; default: *)
# CORS_ORIGINS=https://18-171-204-186.sslip.io,http://localhost:5050
